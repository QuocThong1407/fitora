# Local only. Copy to .env and choose a local password.
# Simple KEY=value syntax, no quotes/substitutions. application-local imports this file.
POSTGRES_DB=fitora
POSTGRES_PORT=5432
FITORA_DB_URL=jdbc:postgresql://localhost:5432/fitora
FITORA_DB_USERNAME=fitora
FITORA_DB_PASSWORD=change-me-local-only
FITORA_SERVER_PORT=8080
